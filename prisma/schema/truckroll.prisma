// Truckroll (clone-owned, PRD §5): technicians, jobs and saved dispatch plans. Times are integer minutes after local
// midnight (D-19), dates are calendar days. Every table is org-owned: RLS policies in the rls_policies_truckroll
// migrations (INV-30), all five in the export (export-hooks.ts, INV-34).

enum JobPriority {
  emergency
  standard
  maintenance
}

/// unscheduled/scheduled are set by a saved plan; the rest are the technician's statuses (Phase 3).
enum JobStatus {
  unscheduled
  scheduled
  en_route
  on_site
  done
  cant_complete
}

model Technician {
  id            String     @id @default(uuid()) @db.Uuid
  orgId         String     @db.Uuid
  org           Org        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  /// The member who is this technician (their own day only, TR-05). Null: a tech without a login.
  userId        String?    @db.Uuid
  user          User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  name          String
  skills        String[] // contract.ts SKILLS; validated on write
  shiftStart    Int
  shiftEnd      Int
  homeLat       Float
  homeLng       Float
  lunchEarliest Int
  lunchLatest   Int
  maxJobs       Int
  createdAt     DateTime   @default(now()) @db.Timestamptz(6)
  pinnedJobs    Job[]
  stops         PlanStop[]

  @@unique([orgId, userId])
  @@index([orgId])
}

model Job {
  id          String      @id @default(uuid()) @db.Uuid
  orgId       String      @db.Uuid
  org         Org         @relation(fields: [orgId], references: [id], onDelete: Cascade)
  ref         String // the shop's job number, unique per org and day
  customer    String
  address     String
  lat         Float
  lng         Float
  date        DateTime    @db.Date
  windowStart Int
  windowEnd   Int
  durationMin Int
  skill       String // contract.ts SKILLS; validated on write
  priority    JobPriority
  status      JobStatus   @default(unscheduled)
  /// A dispatcher pin: a re-plan never moves it (PRD §3). Position is 1-based, optional.
  pinTechId   String?     @db.Uuid
  pinTech     Technician? @relation(fields: [pinTechId], references: [id], onDelete: SetNull)
  pinPosition Int?
  /// Phase 3: when the technician marked the job en route / on site / done (or can't complete), for plan-vs-actual.
  enRouteAt   DateTime?   @db.Timestamptz(6)
  onSiteAt    DateTime?   @db.Timestamptz(6)
  doneAt      DateTime?   @db.Timestamptz(6)
  /// Phase 3: the technician's note when the job can't be completed.
  statusNote  String?
  /// Phase 4: where the customer's ETA text goes (synthetic numbers only in v1, D-55). Null: a draft can't be sent.
  customerPhone String?
  createdAt   DateTime    @default(now()) @db.Timestamptz(6)
  stops       PlanStop[]
  etaTexts    EtaText[]

  @@unique([orgId, date, ref])
  @@index([orgId, date])
}

/// One solve that passed the checker (TR-02). Append-only history; the newest for a date is the current plan.
model DispatchPlan {
  id              String     @id @default(uuid()) @db.Uuid
  orgId           String     @db.Uuid
  org             Org        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  date            DateTime   @db.Date
  createdById     String?    @db.Uuid // no FK: the plan outlives the user, like AuditEvent
  problem         Json
  plan            Json
  metrics         Json
  driveMin        Int
  lateMin         Int
  unassignedCount Int
  stoppedBy       String
  /// Phase 3 re-plan (D-47): the cut-off in minutes after midnight (null = a whole-day plan) and the plan it re-planned.
  /// For a re-plan, `problem` is the re-plan problem and `plan` is the merged day (started stops + the solver's stops).
  asOf            Int?
  basePlanId      String?    @db.Uuid // no FK: plans are append-only history
  /// The solver's plan for the open work, exactly as checkPlan passed it against `problem` (re-plans only).
  solved          Json?
  createdAt       DateTime   @default(now()) @db.Timestamptz(6)
  stops           PlanStop[]
  etaTexts        EtaText[]

  @@index([orgId, date, createdAt])
}

/// A plan's stops as rows, so a technician's day is one scoped query (TR-05).
model PlanStop {
  id       String       @id @default(uuid()) @db.Uuid
  orgId    String       @db.Uuid
  org      Org          @relation(fields: [orgId], references: [id], onDelete: Cascade)
  planId   String       @db.Uuid
  plan     DispatchPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  techId   String       @db.Uuid
  tech     Technician   @relation(fields: [techId], references: [id], onDelete: NoAction)
  jobId    String       @db.Uuid
  job      Job          @relation(fields: [jobId], references: [id], onDelete: NoAction)
  seq      Int
  arrival  Int
  start    Int
  end      Int
  driveMin Int
  slackMin Int
  lateMin  Int

  @@unique([planId, jobId])
  @@index([orgId])
  @@index([techId, planId])
}

enum EtaStatus {
  draft
  sent
  discarded
}

/// Phase 4 (PRD §3 "ETA texts", TR-06): one customer ETA text per job of one saved plan. Drafted by Claude through
/// withBudget or from the template, edited and approved by a dispatcher, then "sent" into CapturedMessage (no real SMS,
/// D-05/D-49). A trigger in the truckroll_phase4 migration refuses a `sent` row without a matching
/// `dispatch.eta_approved` audit event, and any change to a sent row.
model EtaText {
  id                String       @id @default(uuid()) @db.Uuid
  orgId             String       @db.Uuid
  org               Org          @relation(fields: [orgId], references: [id], onDelete: Cascade)
  planId            String       @db.Uuid
  plan              DispatchPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  jobId             String       @db.Uuid
  job               Job          @relation(fields: [jobId], references: [id], onDelete: NoAction)
  /// The customer's phone when drafted (Job.customerPhone). Null: the draft can't be sent.
  phone             String?
  body              String
  /// "llm" (Claude's text passed the validator) or "template".
  source            String
  /// Why the template was used although a model was configured (budget, validator, error). Null otherwise.
  fallbackReason    String?
  status            EtaStatus    @default(draft)
  createdById       String?      @db.Uuid // no FK, like DispatchPlan.createdById
  createdAt         DateTime     @default(now()) @db.Timestamptz(6)
  editedAt          DateTime?    @db.Timestamptz(6)
  approvedById      String?      @db.Uuid
  approvedAt        DateTime?    @db.Timestamptz(6)
  sentAt            DateTime?    @db.Timestamptz(6)
  /// The CapturedMessage row the text was "sent" into (template table, so no FK).
  capturedMessageId String?      @db.Uuid

  @@unique([planId, jobId])
  @@index([orgId, planId])
  @@index([jobId])
}
